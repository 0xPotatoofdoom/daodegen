# Dao DeGen staging environment variables
# Copy to staging.env and adjust as needed before running docker-compose
NODE_ENV=production
PORT=3033
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=staging_walletconnect_project_id
NEXT_PUBLIC_DAODEGEN_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_VERSE_NFT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DAODEGEN_JAR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DAODEGEN_HOOK_ADDRESS=0x0000000000000000000000000000000000000000
# Use your Alchemy/QuickNode RPC URL here to avoid public rate limits
NEXT_PUBLIC_UNICHAIN_RPC=https://sepolia.unichain.org
NEXT_PUBLIC_API_BASE_URL=https://staging-api.daodegen.com
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=
