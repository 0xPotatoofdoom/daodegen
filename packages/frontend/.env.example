# Runtime environment (development|staging|production)
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Chain config — set to "sepolia" or "mainnet"
# This single var drives chainId, RPC URL, and explorer URL throughout the frontend.
# Defaults to "sepolia" for dev safety.
NEXT_PUBLIC_ACTIVE_CHAIN=sepolia
# Optional overrides (auto-derived from NEXT_PUBLIC_ACTIVE_CHAIN if unset):
# NEXT_PUBLIC_CHAIN_ID=1301
# NEXT_PUBLIC_RPC_URL=https://sepolia.unichain.org
# NEXT_PUBLIC_EXPLORER_URL=https://sepolia.unichains.org

# WalletConnect Project ID (required for RainbowKit)
# Get one from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id

# Contract Addresses (update after deployment)
NEXT_PUBLIC_DAODEGEN_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_VERSE_NFT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DAODEGEN_JAR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DAODEGEN_HOOK_ADDRESS=0x0000000000000000000000000000000000000000

# Custom RPC URLs (recommended: use Alchemy/QuickNode to avoid public rate limits)
# Falls back to chain-config preset if unset
NEXT_PUBLIC_UNICHAIN_RPC=https://mainnet.unichain.org

# API Endpoints for metadata and price feeds (optional)
NEXT_PUBLIC_API_BASE_URL=https://api.daodegen.com
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud

# Self-hosted x402 facilitator URL (required for Unichain Sepolia settlement)
# Run the facilitator: npm run facilitator:dev
FACILITATOR_URL=http://localhost:4402

# Optional: CDP facilitator credentials (only needed if using CDP for Base networks)
# CDP_API_KEY_ID=your_cdp_api_key_id
# CDP_API_KEY_SECRET=your_cdp_api_key_secret

# Optional: override the x402 payment recipient address
# X402_PAY_TO=0x3D0e10329c864A7422761af058f909267a776029

# JWT secret for API route authentication (required, >= 32 chars)
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS

# Venice AI (optional — enables privacy-preserving inference for the Venice track)
# Get key at app.venice.ai
VENICE_API_KEY=

# Anthropic API key (fallback LLM if VENICE_API_KEY is not set)
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# Uniswap Trading API key (required for native swap UI, server-only)
# Get from https://developer.uniswap.org
UNISWAP_API_KEY=your_uniswap_api_key

# Analytics and Monitoring (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_xxx

# Ponder indexer API URL (server-side only, enables on-chain congregation stats)
PONDER_API_URL=http://localhost:42069

# Logging
LOG_LEVEL=info
