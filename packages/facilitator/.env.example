# Private key for the facilitator wallet (submits settlement transactions)
FACILITATOR_PRIVATE_KEY=0x_your_private_key

# Port for the facilitator HTTP server (default: 4402)
FACILITATOR_PORT=4402

# Unichain Sepolia RPC URL (default: https://sepolia.unichain.org)
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org

# Redis URL for rate limiting and state persistence (default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Required in production — CORS will reject all cross-origin requests without this
# FRONTEND_ORIGIN=https://daodegen.xyz
