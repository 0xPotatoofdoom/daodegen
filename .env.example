# ===========================================
# Dao DeGen Environment Configuration
# ===========================================
# Copy this to .env and update with your values

# ===========================================
# Smart Contracts (packages/contracts)
# ===========================================

# RPC Endpoints for Unichain
UNICHAIN_RPC=https://unichain.org
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org

# Etherscan API for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Deployment keys (NEVER commit real keys)
PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
DEPLOYER_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# ===========================================
# Frontend (packages/frontend)
# ===========================================

# WalletConnect Project ID (required)
# Get from: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id

# Contract addresses (update after deployment)
NEXT_PUBLIC_DAODEGEN_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_VERSE_NFT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DAODEGEN_JAR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DAODEGEN_HOOK_ADDRESS=0x0000000000000000000000000000000000000000

# API endpoints
NEXT_PUBLIC_API_BASE_URL=https://api.daodegen.com
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud

# ===========================================
# Development & Testing
# ===========================================

# Node environment
NODE_ENV=development

# Debug flags
DEBUG=false
VERBOSE=false

# ===========================================
# External Services (Optional)
# ===========================================

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# IPFS/Pinata for NFT storage
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key