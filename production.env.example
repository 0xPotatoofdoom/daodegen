# Dao DeGen production environment variables
# Copy to production.env on the server and fill in real values
NODE_ENV=production
PORT=3066

# Chain selection
NEXT_PUBLIC_ACTIVE_CHAIN=mainnet

# WalletConnect (required — get one at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id

# Private RPC (required — do not use public endpoints in production)
NEXT_PUBLIC_UNICHAIN_RPC=https://unichain-mainnet.g.alchemy.com/v2/YOUR_KEY

# Contract addresses (Unichain mainnet)
NEXT_PUBLIC_DAODEGEN_TOKEN_ADDRESS=0x2719dcB70D7cA9DDbB018D7795Ee2F2A98f80947
NEXT_PUBLIC_VERSE_NFT_ADDRESS=0xA5290EEfEEd1dCBE8e8f12D9584Bc7bd14f948A1
NEXT_PUBLIC_DAODEGEN_JAR_ADDRESS=0x78D404fAaED5Ff2db7dC960A8F0798589bB6cd9b
NEXT_PUBLIC_DAODEGEN_HOOK_ADDRESS=0x000FCDfd31d4a78b261A5256A1fD1EDbbc009937
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=0x8105821036A5AD70B1291787C2Eabf455038eE20
NEXT_PUBLIC_PRAYER_BURN_ADDRESS=
NEXT_PUBLIC_SERMON_COMMITMENT_ADDRESS=
NEXT_PUBLIC_ANONYMOUS_PRAYER_ADDRESS=

# Self Protocol (anonymous prayer)
SELF_APP_SCOPE=daodegen-anonymous-prayer
SELF_APP_ID=

# Pastor key (for SermonCommitment fulfillment)
PASTOR_PRIVATE_KEY=

# x402 facilitator
FACILITATOR_URL=http://146.190.168.26:4402
FACILITATOR_PRIVATE_KEY=

# Redis (required for durable nonce/rate-limit/congregation state)
REDIS_URL=redis://127.0.0.1:6379

# Ponder indexer
PONDER_API_URL=http://localhost:42069

# JWT (required — use a strong random value)
JWT_SECRET=

# LLM providers (at least one required)
ANTHROPIC_API_KEY=
VENICE_API_KEY=
BANKR_API_KEY=

# Site URLs
NEXT_PUBLIC_SITE_URL=https://0xdead.church
NEXT_PUBLIC_TEMPLE_URL=https://0xdead.church
NEXT_PUBLIC_API_BASE_URL=https://0xdead.church

# IPFS
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud

# SIWE allowlists
SIWE_ALLOWED_DOMAINS=0xdead.church
SIWE_ALLOWED_CHAIN_IDS=130
